# Часть 2. Отдельная виртуальная машина с исходниками приложения.
#
# Задача этой части — не кластер, а перенос кода в машину и проверка, что он
# там оказался. Поэтому машина одна, провижининг сводится к установке tree
# и выводу дерева каталогов.
#
# Запуск из этого каталога:
#   VAGRANT_VAGRANTFILE=Vagrantfile-p2 vagrant up
#
# ── О пути к исходникам ──────────────────────────────────────────────
# Относительные пути в synced_folder Vagrant разрешает от каталога, в котором
# лежит сам Vagrantfile, а не от текущего. Файл лежит в part2/, исходники
# приложения — уровнем выше, поэтому путь начинается с ../
#
# В сданной работе здесь стояло "./services/". Тогда файл лежал в корне
# проекта рядом с каталогом services/, и путь был верным — перенос
# отработал, что видно на скриншоте в отчёте. Позже файл переехал в part2/,
# а путь остался прежним и стал указывать на несуществующий part2/services/.
#
# Само по себе это не выдало бы ошибку: ключ create: true заставляет Vagrant
# создать отсутствующий каталог и смонтировать его пустым. Машина поднимется,
# tree отработает, переносить будет нечего — и всё это без единого
# предупреждения на экране.
#
# Сам каталог services/ приходит с поставкой учебного курса и в этот
# репозиторий не выложен. Чтобы часть отработала, его нужно положить
# рядом с этим проектом.

Vagrant.configure("2") do |config|
  # Определяем имя виртуальной машины
  config.vm.define "vm-part2" do |app|
    # Имя виртуальной машины
    app.vm.box = "ubuntu/jammy64"
    app.vm.hostname = "vm-part2"

    # Перенос исходного кода веб-сервиса в рабочую директорию виртуальной машины
    app.vm.synced_folder "../services/", "/home/vagrant/services", create: true

    # Ресурсов больше, чем у узлов кластера из части 3: здесь на одной машине
    # лежат исходники всех семи микросервисов на Spring Boot
    app.vm.provider "virtualbox" do |vb|
      vb.memory = "3072"
      vb.cpus = 2
    end

    # Shell-скрипт: выполняется при первом запуске (и при provision)
    app.vm.provision "shell", inline: <<-SHELL
      # Обновляю окружение и зависимости
      echo "=== 🔄 Обновление системы ==="
      export DEBIAN_FRONTEND=noninteractive
      apt-get update && apt-get upgrade -y
      # tree - для визуализации структуры каталогов и файлов
      apt-get install tree -y

      # Проверка существования исходника веб-сервиса
      echo "=== 📁➡️💻 Исходный код перенесён успешно, вот структура каталогов:"
      tree -L 3 -C /home/vagrant/

      echo "=== ✅ Готово!!! ==="
    SHELL
  end
end
