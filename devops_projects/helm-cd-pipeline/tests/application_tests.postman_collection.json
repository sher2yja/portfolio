{
  "info": {
    "_postman_id": "8ab15ec0-8499-4a47-baef-e01e58eebf9a",
    "name": "Hotel booking — functional tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Пять запросов, проходящих приложение насквозь: вход пользователя, список отелей, карточка отеля, бронирование и остаток бонусного счёта. Токен, полученный на первом шаге, переиспользуется остальными.\n\nBASIC и BASIC_ADMIN — учебные учётные данные из начальных данных базы (User:qwerty и Admin:qwerty). Это демонстрационный стенд, настоящих учётных данных здесь нет и быть не должно."
  },
  "item": [
    {
      "name": "Login User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login as a regular user\", function() {",
              "    pm.response.to.have.status(200)",
              "    pm.collectionVariables.set(\"BEARER\", pm.response.headers.get(\"authorization\"));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "authorization",
            "value": "{{BASIC}}",
            "type": "default"
          }
        ],
        "url": {
          "raw": "{{API_HOST}}:{{USERS_PORT}}/api/v1/auth/authorize",
          "host": [
            "{{API_HOST}}"
          ],
          "port": "{{USERS_PORT}}",
          "path": [
            "api",
            "v1",
            "auth",
            "authorize"
          ]
        }
      },
      "response": []
    },
