# Шаблон файла с учётными данными приложения.
#
# Копия с настоящими значениями кладётся в ~/.helm-cd/secrets.env и в
# репозиторий не попадает. Каталог можно переопределить переменной
# HELM_CD_SECRETS_DIR.
#
# ---------------------------------------------------------------------------
# Пара ключей для подписи JWT
#
# Формат обязателен: PKCS#8 и X.509 в DER, закодированные base64 ОДНОЙ
# строкой, без заголовков PEM. Приложение читает их через
# PKCS8EncodedKeySpec и X509EncodedKeySpec.
#
# Шаг pkcs8 -topk8 пропускать нельзя. `openssl genpkey -outform DER` даёт
# для RSA традиционный PKCS#1 (base64 начинается с MIIEow), и приложение
# падает на старте с InvalidKeySpecException. Правильный ключ начинается
# с MIIEvQIBADANBgkq, публичный — с MIIBIjANBgkqhkiG.
#
#   mkdir -p ~/.helm-cd
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out /tmp/priv.pem
#   openssl pkcs8 -topk8 -nocrypt -in /tmp/priv.pem -outform DER -out /tmp/priv.der
#   openssl base64 -A -in /tmp/priv.der > ~/.helm-cd/private_key.txt
#   openssl rsa -in /tmp/priv.pem -pubout -outform DER -out /tmp/pub.der
#   openssl base64 -A -in /tmp/pub.der  > ~/.helm-cd/public_key.txt
#   rm /tmp/priv.pem /tmp/priv.der /tmp/pub.der
#
# Проверить формат:
#   base64 -d ~/.helm-cd/private_key.txt | openssl asn1parse -inform DER | head -4
# Во второй строке должно быть SEQUENCE с OBJECT :rsaEncryption, а не INTEGER.
#
# ---------------------------------------------------------------------------
# Учётные данные PostgreSQL.
# POSTGRES_USER заодно задаёт имя базы обслуживания, к которой подключается
# скрипт инициализации.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<задать>

# Учётные данные RabbitMQ. Одно и то же значение получают и брокер
# (RABBITMQ_DEFAULT_USER/PASS), и сервисы, которые к нему подключаются.
RABBIT_MQ_USER=app
RABBIT_MQ_PASSWORD=<задать>
