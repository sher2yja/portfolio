# Конфигурация клиента Consul — ставится на api и db.
#
# server = false: узел не участвует в выборах и не хранит состояние,
# а только регистрирует свои сервисы и проксирует запросы к серверу.
#
# advertise_addr задан шаблоном go-sockaddr, а не фиксированным адресом:
# файл один на оба узла, и каждый подставляет собственный адрес из сети
# стенда. Без шаблона понадобилось бы по конфигурации на узел, а взять
# первый попавшийся интерфейс нельзя — им окажется NAT от Vagrant.
#
# retry_join указывает на сервер. Именно retry_join, а не join: клиент
# повторяет попытки, если сервер ещё не поднялся, и порядок запуска
# машин перестаёт иметь значение.

datacenter = "dc1"
data_dir = "/opt/consul/data"

bind_addr = "0.0.0.0"
advertise_addr = "{{ GetPrivateInterfaces | include \"network\" \"192.168.56.0/24\" | attr \"address\" }}"

client_addr = "0.0.0.0"

server = false
retry_join = ["192.168.56.20"]

connect { enabled = true }
ports { grpc = 8502 }