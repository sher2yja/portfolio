# Инвентарь части 1: два управляемых узла.
#
# Управляющая машина себя в инвентарь не включает — Ansible работает
# на ней самой и подключается только к перечисленным хостам.
#
# Ключ SSH задаётся один раз в [all:vars], а не у каждого хоста:
# доступ на обе машины идёт под одним пользователем с одним ключом.

# ~/ansible/inventory
[nodes]
node01 ansible_host=192.168.56.11 ansible_user=vagrant
node02 ansible_host=192.168.56.12 ansible_user=vagrant

[all:vars]
ansible_ssh_private_key_file=~/.ssh/id_ed25519