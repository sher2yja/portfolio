Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202508.03.0"
  config.vm.hostname = "do14-runner"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider :libvirt do |libvirt|
    libvirt.cpus = 2
    libvirt.memory = 2048
  end

  config.vm.provision "file", source: "mtu.service", destination: "/tmp/do14-runner-mtu.service"
  config.vm.provision "shell", inline: <<-SHELL
    install -m 0644 /tmp/do14-runner-mtu.service /etc/systemd/system/do14-runner-mtu.service
    systemctl daemon-reload
    systemctl enable --now do14-runner-mtu.service
  SHELL
end
