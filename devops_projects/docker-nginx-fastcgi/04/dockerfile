# Часть 4. Первый собственный образ: nginx и FastCGI-приложение вместе.
#
# Базовый образ nginx уже содержит веб-сервер, поэтому остаётся доустановить
# компилятор и библиотеки FastCGI, собрать server.c и запустить оба процесса.
#
# ENTRYPOINT запускает приложение в фоне, а nginx — на переднем плане.
# Порядок важен: контейнер живёт ровно столько, сколько работает процесс
# с PID 1. Если бы на переднем плане оказалось приложение, остановка nginx
# осталась бы незамеченной. Флаг daemon off не даёт nginx уйти в фон и
# завершиться, что для контейнера означало бы немедленную остановку.
#
# Замечания к этой версии, которые разбираются в части 5: образ берётся
# по тегу latest, кеш apt остаётся в слоях, всё работает от root.

FROM nginx:latest

RUN apt-get update && apt-get install -y \
    build-essential \
    libfcgi-dev \
    spawn-fcgi

COPY server.c /app/server.c

COPY ./nginx/nginx.conf /etc/nginx/nginx.conf

RUN gcc -o /app/server /app/server.c -lfcgi

ENTRYPOINT ["sh", "-c", "spawn-fcgi -p 8080 -n /app/server & nginx -g \"daemon off;\""]
